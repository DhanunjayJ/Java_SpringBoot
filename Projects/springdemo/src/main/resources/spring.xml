<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

<!-- Object will be created as many times you mention the 
the bean, it will not just create one!! -->
<!-- <bean id="alien" class="com.dj.Alien" scope="prototype"> </bean> -->


<!-- when you say autowire then it will sewarc fo the the bean with the 
same name as property in the beans and AUTO WIRES!!-->
<!-- <bean id="alien" class="com.dj.Alien" autowire="byName"> -->
<!-- Another autowiring ByType -->
<bean id="alien" class="com.dj.Alien" autowire="byType">
    <property name="age" value="21"></property>
    <!-- <property name="com1" ref="com1"/> -->
    <!-- the whole purpose of the com1 bean is for this bean to intize when it 
    initialize so we can define a inner bean here -->
    <property name="com1">
        <bean id="com1" class="com.dj.Laptop" primary="true"> </bean>
    </property>
</bean>

<bean id="com1" class="com.dj.Laptop" primary="true"> </bean>

<!-- lazy init creates object only when needed when you use it. 
which is when you get bean. 
 instead of creating all the singleton objects at once. -->
 <!-- When you have the lazy bean in a eager bean some where it is used but not 
 lazy then also this bean is being created. when a non lazy bean depeneded on 
 a lazy bean it stil creates the object during context creation.-->

<!-- <bean class="com.dj.Desktop" lazy-init="true"> </bean> -->

</beans>